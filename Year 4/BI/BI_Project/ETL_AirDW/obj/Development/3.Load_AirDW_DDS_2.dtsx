                <component
                  refId="Package\Load Facts\DFT_Load_fact_FlightPerformance\SQL - Update Flights"
                  componentClassID="Microsoft.OLEDBCommand"
                  contactInfo="OLE DB Command;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;2"
                  description="Runs an SQL statement for each row in a data flow. For example, call a 'new employee setup' stored procedure for each row in the 'new employees' table. Note: running an SQL statement for each row of a large data flow may take a long time."
                  name="SQL - Update Flights"
                  usesDispositions="true"
                  version="2">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">UPDATE fact_FlightPerformance
SET
    -- 1. Cập nhật Khóa Ngoại (Time Keys và Cancellation Reason)
    ScheduledDepartureTimeKey = ?,      -- Param 1: ScheduledDepartureTimeKey (New)
    ActualDepartureTimeKey = ?,         -- Param 2: ActualDepartureTimeKey (New)
    ScheduledArrivalTimeKey = ?,        -- Param 3: ScheduledArrivalTimeKey (New)
    ActualArrivalTimeKey = ?,           -- Param 4: ActualArrivalTimeKey (New)
    CancellationReasonKey = ?,          -- Param 5: CancellationReasonKey (New)
    
    -- 2. Cập nhật Cột Đo lường (Time Measures - HHMM INT)
    ScheduledDepartureTime = ?,         -- Param 6: ScheduledDeparture (Cleaned INT)
    ActualDepartureTime = ?,            -- Param 7: DepartureTime (Cleaned INT)
    ScheduledArrivalTime = ?,           -- Param 8: ScheduledArrival (Cleaned INT)
    ActualArrivalTime = ?,              -- Param 9: ArrivalTime (Cleaned INT)
    WheelsOffTime = ?,                  -- Param 10: WheelsOff (Cleaned INT)
    WheelsOnTime = ?,                   -- Param 11: WheelsOn (Cleaned INT)

    -- 3. Cập nhật Đo lường Tính toán (Elapsed Time, Air Time, Distance)
    ScheduledElapsedTime = ?,           -- Param 12: ScheduledTime
    ActualElapsedTime = ?,              -- Param 13: ElapsedTime
    AirTime = ?,                        -- Param 14: AirTime
    DistanceMiles = ?,                  -- Param 15: Distance
    
    -- 4. Cập nhật Đo lường Độ trễ (Delay Measures)
    DepartureDelayMinutes = ?,          -- Param 16: DepartureDelay
    ArrivalDelayMinutes = ?,            -- Param 17: ArrivalDelay
    AirSystemDelayMinutes = ?,          -- Param 18: AirSystemDelay
    SecurityDelayMinutes = ?,           -- Param 19: SecurityDelay
    AirlineDelayMinutes = ?,            -- Param 20: AirlineDelay
    LateAircraftDelayMinutes = ?,       -- Param 21: LateAircraftDelay
    WeatherDelayMinutes = ?,            -- Param 22: WeatherDelay
    
    -- 5. Cập nhật Vận hành Mặt đất và Thông tin khác
    TaxiOutMinutes = ?,                 -- Param 23: TaxiOut
    TaxiInMinutes = ?,                  -- Param 24: TaxiIn
    TailNumber = ?,                     -- Param 25: TailNumber
    
    -- 6. Cập nhật Cờ Trạng thái (Status Flags)
    IsCancelled = ?,                    -- Param 26: Cancelled (BIT)
    IsDiverted = ?,                     -- Param 27: Diverted (BIT)

    -- 7. Cập nhật Cờ Dẫn xuất (Derived Flags)
    IsOnTime = ?,                       -- Param 28: IsOnTime (BIT, đã được tính)
    IsSevereDelay = ?,                  -- Param 29: IsSevereDelay (BIT, đã được tính)
    IsDelayed = ?,                      -- Param 30: IsDelayed (BIT, đã được tính)

    -- 8. Cập nhật Cột Audit
    LoadDate =?
    
-- Điều kiện WHERE: Sử dụng SourceRecordID (FlightFactKey của NDS)
WHERE 
    SourceRecordID = ?;                 -- Param 31: FlightFactKey (từ NDS)</property>
