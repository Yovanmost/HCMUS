    ScheduledTime,
    ElapsedTime,
    AirTime,
    TaxiOut,
    TaxiIn,
    Distance,
    Diverted,
    Cancelled,
    CreatedDate
FROM nds_FlightFacts
WHERE CreatedDate &gt; ?
ORDER BY FlightFactKey</property>
