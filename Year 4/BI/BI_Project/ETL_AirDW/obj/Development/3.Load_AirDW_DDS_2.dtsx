              SQLTask:SqlStatementSource="USE AirDW_DDS;&#xA;GO&#xA;&#xA;SET NOCOUNT ON;&#xA;&#xA;-- 1. Khai báo khoảng thời gian&#xA;DECLARE @EndDate DATE = '2025-12-31';&#xA;DECLARE @MaxExistingDate DATE;&#xA;DECLARE @CurrentDate DATE;&#xA;&#xA;-- 2. Tìm ngày lớn nhất đã tồn tại&#xA;SELECT @MaxExistingDate = MAX(FullDate) FROM dim_Date;&#xA;&#xA;-- 3. Thiết lập @CurrentDate&#xA;-- Nếu bảng rỗng, bắt đầu từ ngày bắt đầu mong muốn ('2015-01-01')&#xA;IF @MaxExistingDate IS NULL&#xA;BEGIN&#xA;    SET @CurrentDate = '2015-01-01';&#xA;END&#xA;-- Nếu đã có dữ liệu, bắt đầu từ ngày tiếp theo của ngày lớn nhất&#xA;ELSE&#xA;BEGIN&#xA;    SET @CurrentDate = DATEADD(DD, 1, @MaxExistingDate);&#xA;END&#xA;&#xA;-- 4. Vòng lặp để insert các ngày thiếu (từ @CurrentDate đến @EndDate)&#xA;WHILE @CurrentDate &lt;= @EndDate&#xA;BEGIN&#xA;    -- [GIỮ NGUYÊN ĐOẠN INSERT INTO dim_Date ... SELECT ... CỦA BẠN]&#xA;    INSERT INTO dim_Date (&#xA;        DateKey, &#xA;        FullDate, &#xA;        DayOfWeek, &#xA;        DayName, &#xA;        DayOfMonth, &#xA;        DayOfYear, &#xA;        WeekOfYear, &#xA;        Month, &#xA;        MonthName, &#xA;        MonthYear, &#xA;        Quarter, &#xA;        QuarterName, &#xA;        Year, &#xA;        IsWeekend, &#xA;        Season&#xA;    )&#xA;    SELECT &#xA;        CAST(CONVERT(VARCHAR(8), @CurrentDate, 112) AS INT),&#xA;        @CurrentDate,&#xA;        DATEPART(DW, @CurrentDate),&#xA;        DATENAME(DW, @CurrentDate),&#xA;        DAY(@CurrentDate),&#xA;        DATEPART(DY, @CurrentDate),&#xA;        DATEPART(WK, @CurrentDate),&#xA;        MONTH(@CurrentDate),&#xA;        DATENAME(MM, @CurrentDate),&#xA;        FORMAT(@CurrentDate, 'yyyy-MM'),&#xA;        DATEPART(QQ, @CurrentDate),&#xA;        'Q' + CAST(DATEPART(QQ, @CurrentDate) AS VARCHAR(1)),&#xA;        YEAR(@CurrentDate),&#xA;        CASE WHEN DATENAME(DW, @CurrentDate) IN ('Saturday', 'Sunday') THEN 1 ELSE 0 END,&#xA;        CASE &#xA;            WHEN MONTH(@CurrentDate) IN (3, 4, 5) THEN 'Spring'&#xA;            WHEN MONTH(@CurrentDate) IN (6, 7, 8) THEN 'Summer'&#xA;            WHEN MONTH(@CurrentDate) IN (9, 10, 11) THEN 'Fall'&#xA;            ELSE 'Winter'&#xA;        END;&#xA;&#xA;    -- Tăng biến ngày lên 1&#xA;    SET @CurrentDate = DATEADD(DD, 1, @CurrentDate);&#xA;END&#xA;&#xA;PRINT 'Đã hoàn tất kiểm tra và load các ngày thiếu vào dim_Date';&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Load Dimensions\SQL - Load_dim_Time"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{D0DDC910-2F60-4D68-A38B-DD3A3E98E77A}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL - Load_dim_Time"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{9E0CD2BD-5880-42E6-8731-A12776C1B382}"
              SQLTask:SqlStatementSource="USE AirDW_DDS;&#xA;GO&#xA;&#xA;SET NOCOUNT ON;&#xA;&#xA;-- Kiểm tra xem bảng dim_Time đã có dữ liệu chưa.&#xA;-- Nếu bảng rỗng, thực hiện INSERT.&#xA;IF NOT EXISTS (SELECT 1 FROM dim_Time)&#xA;BEGIN&#xA;    -- 1. Thêm Bản ghi Unknown (Dòng bắt buộc cho Data warehouse)&#xA;    INSERT INTO dim_Time (&#xA;        TimeKey, &#xA;        Hour, &#xA;        Minute, &#xA;        HourName, &#xA;        TimeBand, &#xA;        TimeBandSort&#xA;    )&#xA;    VALUES (&#xA;        -1, &#xA;        -1, &#xA;        -1, &#xA;        'N/A', &#xA;        'N/A', &#xA;        0&#xA;    );&#xA;&#xA;    -- 2. Khai báo biến và chạy vòng lặp&#xA;    DECLARE @Hour INT = 0;&#xA;    DECLARE @Minute INT = 0;&#xA;    DECLARE @TimeKey INT;&#xA;    DECLARE @HourName VARCHAR(5);&#xA;    DECLARE @TimeBand VARCHAR(20);&#xA;    DECLARE @TimeBandSort INT;&#xA;&#xA;    -- Vòng lặp Giờ (0-23)&#xA;    WHILE @Hour &lt; 24&#xA;    BEGIN&#xA;        SET @Minute = 0;&#xA;        &#xA;        -- Vòng lặp Phút (0-59)&#xA;        WHILE @Minute &lt; 60&#xA;        BEGIN&#xA;            -- Tạo TimeKey: HHMM&#xA;            SET @TimeKey = (@Hour * 100) + @Minute;&#xA;            &#xA;            -- Tạo HourName&#xA;            SET @HourName = RIGHT('0' + CAST(@Hour AS VARCHAR(2)), 2) + ':00';&#xA;            &#xA;            -- Logic TimeBand (Khung giờ) - Đã sửa lỗi cú pháp bằng cách thêm BEGIN/END&#xA;            IF @Hour BETWEEN 0 AND 5 &#xA;            BEGIN &#xA;                SET @TimeBand = 'Night'; &#xA;                SET @TimeBandSort = 1;&#xA;            END&#xA;            ELSE IF @Hour BETWEEN 6 AND 11 &#xA;            BEGIN &#xA;                SET @TimeBand = 'Morning'; &#xA;                SET @TimeBandSort = 2;&#xA;            END&#xA;            ELSE IF @Hour BETWEEN 12 AND 17 &#xA;            BEGIN &#xA;                SET @TimeBand = 'Afternoon'; &#xA;                SET @TimeBandSort = 3;&#xA;            END&#xA;            ELSE -- 18-23&#xA;            BEGIN &#xA;                SET @TimeBand = 'Evening'; &#xA;                SET @TimeBandSort = 4;&#xA;            END&#xA;&#xA;            -- Insert vào bảng&#xA;            INSERT INTO dim_Time (&#xA;                TimeKey, &#xA;                Hour, &#xA;                Minute, &#xA;                HourName, &#xA;                TimeBand, &#xA;                TimeBandSort&#xA;            )&#xA;            VALUES (&#xA;                @TimeKey, &#xA;                @Hour, &#xA;                @Minute, &#xA;                @HourName, &#xA;                @TimeBand, &#xA;                @TimeBandSort&#xA;            );&#xA;&#xA;            SET @Minute = @Minute + 1;&#xA;        END&#xA;        &#xA;        SET @Hour = @Hour + 1;&#xA;    END&#xA;&#xA;    PRINT 'Đã load xong dữ liệu dim_Time (Chỉ chạy một lần)';&#xA;END&#xA;ELSE&#xA;BEGIN&#xA;    PRINT 'dim_Time đã tồn tại dữ liệu. Bỏ qua việc tải.';&#xA;END&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
