                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    FlightFactKey,
    AirlineKey,
    OriginAirportKey,
    DestinationAirportKey,
    CancellationReasonKey,
    FlightDate,
    FlightNumber,
    TailNumber,
