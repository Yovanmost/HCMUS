    <DTS:Executable
      DTS:refId="Package\SQL - Load_dim_Date"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{4984ee00-17e3-46d6-b6a3-709e3a72c950}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Load_dim_Date"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="5">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9E0CD2BD-5880-42E6-8731-A12776C1B382}"
          SQLTask:SqlStatementSource="USE AirDW_DDS;&#xA;GO&#xA;&#xA;-- Xóa dữ liệu cũ nếu cần load lại&#xA;TRUNCATE TABLE dim_Date;&#xA;GO&#xA;&#xA;SET NOCOUNT ON;&#xA;&#xA;-- 1. Khai báo khoảng thời gian&#xA;DECLARE @StartDate DATE = '2015-01-01';&#xA;DECLARE @EndDate DATE = '2025-12-31';&#xA;DECLARE @CurrentDate DATE = @StartDate;&#xA;&#xA;-- 2. Vòng lặp để insert từng ngày&#xA;WHILE @CurrentDate &lt;= @EndDate&#xA;BEGIN&#xA;    INSERT INTO dim_Date (&#xA;        DateKey, &#xA;        FullDate, &#xA;        DayOfWeek, &#xA;        DayName, &#xA;        DayOfMonth, &#xA;        DayOfYear, &#xA;        WeekOfYear, &#xA;        Month, &#xA;        MonthName, &#xA;        MonthYear, &#xA;        Quarter, &#xA;        QuarterName, &#xA;        Year, &#xA;        IsWeekend, &#xA;        Season&#xA;    )&#xA;    SELECT &#xA;        -- DateKey: YYYYMMDD (Ví dụ: 20230101)&#xA;        CAST(CONVERT(VARCHAR(8), @CurrentDate, 112) AS INT),&#xA;        &#xA;        @CurrentDate,&#xA;        &#xA;        -- DayOfWeek (1=Sunday, ... 7=Saturday) - Tùy chỉnh theo DATEFIRST, ở đây dùng chuẩn US&#xA;        DATEPART(DW, @CurrentDate),&#xA;        &#xA;        DATENAME(DW, @CurrentDate),&#xA;        DAY(@CurrentDate),&#xA;        DATEPART(DY, @CurrentDate),&#xA;        DATEPART(WK, @CurrentDate),&#xA;        &#xA;        MONTH(@CurrentDate),&#xA;        DATENAME(MM, @CurrentDate),&#xA;        &#xA;        -- MonthYear: YYYY-MM&#xA;        FORMAT(@CurrentDate, 'yyyy-MM'),&#xA;        &#xA;        DATEPART(QQ, @CurrentDate),&#xA;        'Q' + CAST(DATEPART(QQ, @CurrentDate) AS VARCHAR(1)),&#xA;        &#xA;        YEAR(@CurrentDate),&#xA;        &#xA;        -- IsWeekend (1 nếu là T7 hoặc CN)&#xA;        CASE &#xA;            WHEN DATENAME(DW, @CurrentDate) IN ('Saturday', 'Sunday') THEN 1 &#xA;            ELSE 0 &#xA;        END,&#xA;        &#xA;        -- Season (Logic Bắc Bán Cầu)&#xA;        CASE &#xA;            WHEN MONTH(@CurrentDate) IN (3, 4, 5) THEN 'Spring'&#xA;            WHEN MONTH(@CurrentDate) IN (6, 7, 8) THEN 'Summer'&#xA;            WHEN MONTH(@CurrentDate) IN (9, 10, 11) THEN 'Fall'&#xA;            ELSE 'Winter'&#xA;        END;&#xA;&#xA;    -- Tăng biến ngày lên 1&#xA;    SET @CurrentDate = DATEADD(DD, 1, @CurrentDate);&#xA;END&#xA;&#xA;PRINT 'Đã load xong dữ liệu dim_Date';&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Load_dim_Time"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{dba439c2-74e4-4b9c-8a64-0f9b29e67475}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Load_dim_Time"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="6">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9E0CD2BD-5880-42E6-8731-A12776C1B382}"
          SQLTask:SqlStatementSource="USE AirDW_DDS;&#xA;GO&#xA;&#xA;TRUNCATE TABLE dim_Time;&#xA;GO&#xA;&#xA;-- Thêm Bản ghi Unknown (Dòng bắt buộc cho Data warehouse)&#xA;INSERT INTO dim_Time (&#xA;    TimeKey, &#xA;    Hour, &#xA;    Minute, &#xA;    HourName, &#xA;    TimeBand, &#xA;    TimeBandSort&#xA;)&#xA;VALUES (&#xA;    -1, &#xA;    -1, &#xA;    -1, &#xA;    'N/A', &#xA;    'N/A', &#xA;    0&#xA;);&#xA;GO&#xA;&#xA;SET NOCOUNT ON;&#xA;&#xA;DECLARE @Hour INT = 0;&#xA;DECLARE @Minute INT = 0;&#xA;DECLARE @TimeKey INT;&#xA;DECLARE @HourName VARCHAR(5);&#xA;DECLARE @TimeBand VARCHAR(20);&#xA;DECLARE @TimeBandSort INT;&#xA;&#xA;-- Vòng lặp Giờ (0-23)&#xA;WHILE @Hour &lt; 24&#xA;BEGIN&#xA;    SET @Minute = 0;&#xA;    &#xA;    -- Vòng lặp Phút (0-59)&#xA;    WHILE @Minute &lt; 60&#xA;    BEGIN&#xA;        -- Tạo TimeKey: HHMM (Ví dụ: 1030, 905, 0)&#xA;        SET @TimeKey = (@Hour * 100) + @Minute;&#xA;        &#xA;        -- Tạo HourName: &quot;00:00&quot;, &quot;01:00&quot;&#xA;        SET @HourName = RIGHT('0' + CAST(@Hour AS VARCHAR(2)), 2) + ':00';&#xA;        &#xA;        -- Logic TimeBand (Khung giờ)&#xA;        IF @Hour BETWEEN 0 AND 5 &#xA;        BEGIN&#xA;            SET @TimeBand = 'Night';&#xA;            SET @TimeBandSort = 1;&#xA;        END&#xA;        ELSE IF @Hour BETWEEN 6 AND 11 &#xA;        BEGIN&#xA;            SET @TimeBand = 'Morning';&#xA;            SET @TimeBandSort = 2;&#xA;        END&#xA;        ELSE IF @Hour BETWEEN 12 AND 17 &#xA;        BEGIN&#xA;            SET @TimeBand = 'Afternoon';&#xA;            SET @TimeBandSort = 3;&#xA;        END&#xA;        ELSE -- 18-23&#xA;        BEGIN&#xA;            SET @TimeBand = 'Evening';&#xA;            SET @TimeBandSort = 4;&#xA;        END&#xA;&#xA;        -- Insert vào bảng&#xA;        INSERT INTO dim_Time (&#xA;            TimeKey, &#xA;            Hour, &#xA;            Minute, &#xA;            HourName, &#xA;            TimeBand, &#xA;            TimeBandSort&#xA;        )&#xA;        VALUES (&#xA;            @TimeKey, &#xA;            @Hour, &#xA;            @Minute, &#xA;            @HourName, &#xA;            @TimeBand, &#xA;            @TimeBandSort&#xA;        );&#xA;&#xA;        SET @Minute = @Minute + 1;&#xA;    END&#xA;    &#xA;    SET @Hour = @Hour + 1;&#xA;END&#xA;&#xA;PRINT 'Đã load xong dữ liệu dim_Time';&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
