                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    MaKH,
    TenKH,
    NULL AS DiaChi,  -- WebTower9 không có DiaChi
    CAST (TenNuoc AS VARCHAR(50)) AS TenNuoc,
    GioiTinh,
    SoThich,
    NgheNghiep,
    3 AS SourceID,  -- WebTower9 = Source 3
    NgayTao,
    NgayCapNhat,
    TrangThai
FROM KhachHang_WebTower9
WHERE TrangThai = 1</property>
