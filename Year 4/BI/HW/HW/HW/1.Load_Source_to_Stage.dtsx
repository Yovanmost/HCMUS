                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    MaKH,
    TenKH,
    DiaChi,
    NULL AS TenNuoc,  -- Jade không có TenNuoc
    GioiTinh,
    SoThich,
    NgheNghiep,
    1 AS SourceID,  -- Jade = Source 1
    NgayTao,
    NgayCapNhat,
    TrangThai
FROM KhachHang_Jade
WHERE TrangThai = 1</property>
