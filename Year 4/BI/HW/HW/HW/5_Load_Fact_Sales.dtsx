                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
 
    bd.BillDetail_ID,

    p.ProductNK,

    c.CusNK,

    s.StoreNK,

    1 AS Quantity, -- Assuming each detail line is 1 item
    p.ProductPrice,

    p.ProductPrice * 1 AS Amount,

    b.Bill_ID,

    b.SaleDate

FROM BillDetail_NDS bd 

INNER JOIN Bill_NDS b ON bd.Bill_ID = b.Bill_ID

INNER JOIN Product_NDS p ON bd.ProductID = p.ProductID

INNER JOIN Customer_NDS AS c ON b.CusID = c.CusID


INNER JOIN Store_NDS AS s ON b.StoreID = s.StoreID</property>
